{
  "version": 3,
  "configurePresets": [
    {
      "name": "cmake-dev",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {},
      "warnings": {
        "deprecated": true,
        "dev": true
      },
      "errors": {
        "deprecated": true
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "STRING",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_OVERLAY_PORTS": {
          "type": "STRING",
          "value": "${sourceDir}/cmake/ports"
        }
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": {
          "type": "STRING",
          "value": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
        },
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-windows-static"
        }
      }
    },
    {
      "name": "vs-windows",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "inherits": [
        "cmake-dev",
        "vcpkg",
        "windows"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/EHsc /MP /W4",
        "CMAKE_CXX_FLAGS_DEBUG": "/WX"
      }
    },
    {
      "name": "vs-windows-github",
      "inherits": [
        "vs-windows"
      ],
      "cacheVariables": {
        "GITHUB": {
          "type": "BOOL",
          "value": true
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs-debug",
      "configurePreset": "vs-windows",
      "configuration": "Debug"
    },
    {
      "name": "vs-relwithdebinfo",
      "configurePreset": "vs-windows",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "vs-github-relwithdebinfo",
      "configurePreset": "vs-windows-github",
      "configuration": "RelWithDebInfo"
    }
  ]
}